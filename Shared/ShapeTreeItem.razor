@inherits ShapeTreeItemBase
@using FoundryBlazor.Shape

@namespace FoundryBlazor.Shared

<style>
    .item {
        display: flex;
        margin: 0;
        padding: 2px 0;
        list-style-type: none;
        cursor: pointer;
        align-items: center;
        min-height: 20px;
    }

    .item:hover {
        background-color: azure;
    }

    .item.selected {
        background-color: lightblue;
    }

    .item > .arrow, .arrow-placeholder {
        min-width: 16px;
        width: 16px;
        flex-shrink: 0;
        user-select: none;
    }

    .item > .arrow:hover {
        color: steelblue;
    }

    .tree-action-btn {
        display: inline-block;
        margin-left: 6px;
        padding: 2px 6px;
        font-size: 10px;
        line-height: 1.2;
        border: none;
        border-radius: 3px;
        background: #6c757d;
        color: white;
        text-decoration: none;
        white-space: nowrap;
        cursor: pointer;
        flex-shrink: 0;
        height: auto;
        min-width: auto;
        width: auto;
    }

    .tree-action-btn:hover {
        background: #5a6268;
        color: white;
        text-decoration: none;
    }

    .context-menu-trigger {
        display: inline-block;
        margin-left: 6px;
        padding: 0 4px;
        font-size: 12px;
        color: #6c757d;
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.2s;
        user-select: none;
    }

    .item:hover .context-menu-trigger {
        opacity: 1;
    }

    .context-menu-trigger:hover {
        color: #495057;
        background: #f8f9fa;
        border-radius: 3px;
    }

    .context-menu {
        position: absolute;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 4px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
        z-index: 1000;
        min-width: 120px;
        padding: 4px 0;
    }

    .context-menu-item {
        display: block;
        padding: 6px 12px;
        font-size: 12px;
        color: #495057;
        text-decoration: none;
        cursor: pointer;
        border: none;
        background: none;
        width: 100%;
        text-align: left;
    }

    .context-menu-item:hover {
        background: #f8f9fa;
        color: #212529;
    }

    .text {
        flex: 0 1 auto;
        margin-right: 6px;
        font-size: 12px;
        white-space: nowrap;
    }
</style>

@if (Items != null)
{
    foreach (var item in GetItems())
    {

        <li class="item@(item.GetIsSelected() ? " selected" : "")" style="padding-left: @(Level * 16)px"
            id="tree-item-@(item.GetHashCode())"
            @onclick="() => ItemSelected(item)">
            @if (item.HasChildren())
            {
                <span class="arrow" @onclick="() => ToggleExpanded(item)" @onclick:stopPropagation>
                    @(item.IsCollapsed() ? "▶" : "◢")
                </span>
            }
            else
            {
                <span class="arrow-placeholder"></span>
            }
            <span class="text">@item.GetTreeNodeTitle()</span>

            @if (item.GetTreeNodeActions() != null && item.GetTreeNodeActions()!.Any())
            {
                <span class="context-menu-trigger" @onclick="(e) => ToggleContextMenu(item, e)" @onclick:stopPropagation>
                    ⋯
                </span>
                
                @if (contextMenuVisible && contextMenuItem == item)
                {
                    <div class="context-menu" style="top: @(contextMenuY)px; left: @(contextMenuX)px;">
                        @foreach (var action in item.GetTreeNodeActions()!)
                        {
                            <button class="context-menu-item" 
                                @onclick="() => ExecuteContextAction(item, action)">@action.Name</button>
                        }
                    </div>
                }
            }

        </li>

        @if (item.HasChildren() && !item.IsCollapsed())
        {
            <ShapeTreeItem 
                Items = "@item.GetTreeChildren()" 
                Parent = "@item"
                Level = "@(Level + 1)" 
                OnSelect="ItemSelected">
            </ShapeTreeItem>
        }
    }
}
