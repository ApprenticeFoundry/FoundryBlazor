{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: Three2025${cwd} Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/Three2025/Three2025.csproj"
        },
        {
            // FoundryBlazor is a class library - use this for debugging with a test project
            "name": "FoundryBlazor Library Build",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            // Note: This is a class library, so there's no executable to launch
            "program": "${workspaceFolder}/bin/Debug/net9.0/FoundryBlazor.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ]
}