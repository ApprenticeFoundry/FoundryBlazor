<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <IsPackable>true</IsPackable>
    <LangVersion>12.0</LangVersion>
    <Copyright>Copyright © 2020</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <JsLibRoot>JsLib\</JsLibRoot>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(JsLibRoot)node_modules\**</DefaultItemExcludes>
    <!-- Static web assets configuration for NuGet package consumption -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetBasePath>_content/ApprenticeFoundryBlazor</StaticWebAssetBasePath>
    
    <!-- Exclude duplicate files to prevent build errors -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <RestoreSources>$(RestoreSources);https://api.nuget.org/v3/index.json</RestoreSources>

    <Title>Apprentice Foundry Blazor</Title>
    <description>A comprehensive C# / Blazor diagramming library that combines 2D and 3D visualization capabilities. Supports .NET 9, includes advanced layout algorithms, glued connections, multi-page diagrams, and seamless 2D/3D integration.</description>
    <packageTags>Foundry, 2D, 3D, Visio, Blazor, Diagramming, Graphics, Visualization, NET9</packageTags>
    <RepositoryUrl>https://github.com/SteveStrong/FoundryBlazor</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageId>ApprenticeFoundryBlazor</PackageId>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Copyright>Copyright © 2025</Copyright>
    <AssemblyVersion>23.4.0</AssemblyVersion>
    <Version>23.4.0</Version>
    <Authors>Stephen Strong</Authors>
    <Company>Stephen Strong</Company>
    <PackageProjectUrl>https://apprenticefoundry.github.io/</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>



<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
  <Optimize>True</Optimize>
</PropertyGroup>

<ItemGroup>
  <FrameworkReference Include="Microsoft.AspNetCore.App" />
</ItemGroup>

  <PropertyGroup>
      <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
      <None Include="INTEGRATION_GUIDE.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Explicitly include required static web assets -->
  <!-- NOTE: Ensure no conflicts with BlazorThreeJS static assets -->
  <ItemGroup>
    <Content Include="wwwroot\css\**\*" BuildAction="StaticWebAsset" />
    <Content Include="wwwroot\js\app-lib.js" BuildAction="StaticWebAsset" />
    <Content Include="wwwroot\favicon.ico" BuildAction="StaticWebAsset" />
    <Content Include="wwwroot\images\**\*" BuildAction="StaticWebAsset" />
  </ItemGroup>

<!-- <ItemGroup> 
  <ProjectReference Include="..\BlazorThreeJS\BlazorThreeJS.csproj" />
</ItemGroup> -->

<ItemGroup>
  <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="9.0.9" />
  <PackageReference Include="ApprenticeFoundryBlazorThreeJS" Version="23.1.0" />
</ItemGroup>


 <ItemGroup>
  <PackageReference Include="ApprenticeFoundryRulesAndUnits" Version="9.0.0" />
  <PackageReference Include="Blazor.Extensions.Canvas" Version="1.1.1" />
  <PackageReference Include="BlazorComponentBus" Version="2.2.0" />

  <!-- <PackageReference Include="Microsoft.AspNetCore.SignalR.Core" Version="8.0.0" />
  <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.8" /> -->
  
  <PackageReference Include="QRCoder" Version="1.6.0" />    
  <PackageReference Include="Radzen.Blazor" Version="7.3.5" />

  <PackageReference Include="SkiaSharp" Version="3.119.0" />
  <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.0" />
</ItemGroup>



</Project>
